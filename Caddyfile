{
	admin off
}

{$SAGEP_HOSTNAME} {
	tls /etc/caddy/pki/server.crt /etc/caddy/pki/server.key
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@api path /api/*
	reverse_proxy @api api:3000
	reverse_proxy frontend:8080
}

PORT=3000
API_PORT=3000
NODE_ENV=development

# Local host connection. Inside Docker Compose, use postgres as host:
# postgresql://sagep:sagep123@postgres:5432/sagep?schema=public
DATABASE_URL="postgresql://sagep:sagep123@localhost:5432/sagep?schema=public"
DOCKER_DATABASE_URL="postgresql://sagep:sagep123@postgres:5432/sagep?schema=public"
DOCKER_NODE_ENV=production

# JWT_SECRET is accepted as the access-token secret.
# JWT_ACCESS_SECRET is still supported for backward compatibility.
JWT_SECRET="troque-por-um-segredo-forte"
JWT_REFRESH_SECRET="troque-por-outro-segredo-forte"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PDF_TIMEOUT_MS=60000
PDF_RENDER_MODE=real
COMPRAS_GOV_DEBUG=false
PORTAL_TRANSPARENCIA_API_TOKEN=

# Lista separada por virgulas. Vazia bloqueia origens de navegador externas.
CORS_ALLOWED_ORIGINS="http://localhost:4200"
CORS_ALLOW_CREDENTIALS=false

# Mantenha desativado quando usuarios forem provisionados por administradores.
ALLOW_PUBLIC_REGISTRATION=false

POSTGRES_USER=sagep
POSTGRES_PASSWORD=sagep123
POSTGRES_DB=sagep
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@sagep.com
PGADMIN_DEFAULT_PASSWORD=sagep123
PGADMIN_PORT=5051

PORT=3000
API_PORT=3000
NODE_ENV=development

# Local host connection. Inside Docker Compose, use postgres as host:
# Substitua <senha-postgres> pela mesma senha definida em POSTGRES_PASSWORD.
# Dentro do Docker Compose, use postgres como host.
DATABASE_URL="postgresql://sagep:<senha-postgres>@localhost:5432/sagep?schema=public"
DOCKER_DATABASE_URL="postgresql://sagep:<senha-postgres>@postgres:5432/sagep?schema=public"
DOCKER_NODE_ENV=production

# JWT_SECRET is accepted as the access-token secret.
# JWT_ACCESS_SECRET is still supported for backward compatibility.
# Gere valores distintos com `openssl rand -hex 32`. Em produção, cada segredo
# precisa ter pelo menos 32 caracteres; não reutilize os exemplos literalmente.
JWT_SECRET="<gere-um-segredo-aleatorio-com-no-minimo-32-caracteres>"
JWT_REFRESH_SECRET="<gere-outro-segredo-distinto-com-no-minimo-32-caracteres>"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
AUTH_REFRESH_COOKIE_NAME=sagep_refresh
# true quando a aplicação for publicada exclusivamente por HTTPS.
AUTH_COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SENSITIVE_RATE_LIMIT_MAX=20
# Tempo de validade da confirmação de senha para operações críticas (1 a 15 min).
STEP_UP_EXPIRES_IN_SECONDS=300

PDF_TIMEOUT_MS=60000
PDF_RENDER_MODE=real
COMPRAS_GOV_DEBUG=false
PORTAL_TRANSPARENCIA_API_TOKEN=
PORTAL_TRANSPARENCIA_BASE_URL=https://api.portaldatransparencia.gov.br/api-de-dados
PORTAL_TRANSPARENCIA_SYNC_INTERVAL_MINUTES=1440

# Lista separada por virgulas. Vazia bloqueia origens de navegador externas.
CORS_ALLOWED_ORIGINS="http://localhost:4200"
CORS_ALLOW_CREDENTIALS=true

# Mantenha desativado quando usuarios forem provisionados por administradores.
ALLOW_PUBLIC_REGISTRATION=false
HEALTH_PGADMIN_URL=http://pgadmin/misc/ping
HEALTH_PROBE_TIMEOUT_MS=2000

# Backup PostgreSQL. No Docker Compose, o diretorio usa um volume persistente.
BACKUP_DIRECTORY=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_FILES=30
BACKUP_SCHEDULE_HOURS=24
BACKUP_RUN_ON_STARTUP=false
BACKUP_MAX_UPLOAD_MB=512

POSTGRES_USER=sagep
POSTGRES_PASSWORD=<defina-uma-senha-forte>
POSTGRES_DB=sagep
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@sagep.com
PGADMIN_DEFAULT_PASSWORD=<defina-outra-senha-forte>
PGADMIN_PORT=5051
